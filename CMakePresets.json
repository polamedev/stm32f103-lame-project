{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "cacheVariables": {
            }
        },
        {
            "name": "Develop",
            "inherits": "default",
            "cacheVariables": {
                "BUILD_TESTS": "OFF",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Tests",
            "inherits": "Develop",
            "cacheVariables": {
                "BUILD_TESTS": "ON"
            }
        }
    ]
}